{
  "$schema": "https://turborepo.com/schema.json",
  "globalEnv": [
    "NODE_ENV"
  ],
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "env": [
        "ANSPIRE_API_ENDPOINT",
        "ANSPIRE_API_KEY",
        "BB_PRESET_SNAPSHOT_ENABLED",
        "BB_SITE_ROOT",
        "COLLECTOR_ENABLE_SUBJECT_AI_SCORE",
        "COLLECTOR_SKIP_AI_SUMMARY",
        "COLLECT_RECALL_QUERY_LIMIT",
        "COLLECT_SOURCE_CONCURRENCY",
        "CREDENTIAL_ENCRYPTION_KEY",
        "DATABASE_URL",
        "DEEPSEEK_API_KEY",
        "DEEPSEEK_BASE_URL",
        "DEFAULT_USER_ID",
        "DIRECT_URL",
        "DOTENV_KEY",
        "DOTENV_PRIVATE_KEY",
        "EMBEDDING_MODEL",
        "GATHER_API_IO_LOG_DIR",
        "GATHER_API_IO_LOG_MAX_CHARS",
        "GATHER_HOST",
        "GATHER_OPENCLI_BIN",
        "GATHER_OPENCLI_CWD",
        "GATHER_PLAYWRIGHT_POOL_SWEEP_INTERVAL_MS",
        "GATHER_PORT",
        "GATHER_RELOAD",
        "GATHER_SERVICE_URL",
        "GOOGLE_GENERATIVE_AI_API_KEY",
        "LLM_DEFAULT_MODEL",
        "LOG_APP_NAME",
        "LOG_LEVEL",
        "MINIO_ACCESS_KEY",
        "MINIO_BUCKET",
        "MINIO_ENDPOINT",
        "MINIO_REGION",
        "MINIO_SECRET_KEY",
        "OPENAI_API_KEY",
        "OPEN_API_BASE_URL",
        "PARALLEL_API_ENDPOINT",
        "PARALLEL_API_KEY",
        "PRISMA_ACCELERATE_URL",
        "QUERY_SCHEDULE_TZ",
        "REDIS_HOST",
        "REDIS_PASSWORD",
        "REDIS_PORT",
        "S3_ACCESS_KEY",
        "S3_BUCKET",
        "S3_ENDPOINT",
        "S3_REGION",
        "S3_SECRET_KEY",
        "SEARCH_ENGINE",
        "TAVILY_API_ENDPOINT",
        "TAVILY_API_KEY",
        "WEB_DERIVE_IO_LOG_DIR",
        "WEB_DERIVE_IO_LOG_ENABLED",
        "WEB_DERIVE_IO_LOG_MAX_CHARS",
        "WEB_DERIVE_RECALL_SOFT_LIMIT",
        "WORKER_API_IO_LOG_DIR",
        "WORKER_API_IO_LOG_ENABLED",
        "WORKER_API_IO_LOG_MAX_CHARS",
        "WORKER_CAPABILITIES_HOST",
        "WORKER_CAPABILITIES_HTTP_ENABLED",
        "WORKER_CAPABILITIES_PORT",
        "WORKER_PARALLEL_REQUEST_TIMEOUT_MS",
        "WORKER_SERVICE_URL"
      ],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["apps/**/.next/**", "apps/**/dist/**", "!apps/**/.next/cache/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "test": {
      "dependsOn": ["^test"],
      "env": [
        "ANSPIRE_API_ENDPOINT",
        "ANSPIRE_API_KEY",
        "BB_PRESET_SNAPSHOT_ENABLED",
        "BB_SITE_ROOT",
        "COLLECTOR_ENABLE_SUBJECT_AI_SCORE",
        "COLLECTOR_SKIP_AI_SUMMARY",
        "COLLECT_RECALL_QUERY_LIMIT",
        "COLLECT_SOURCE_CONCURRENCY",
        "CREDENTIAL_ENCRYPTION_KEY",
        "DATABASE_URL",
        "DEEPSEEK_API_KEY",
        "DEEPSEEK_BASE_URL",
        "DEFAULT_USER_ID",
        "DIRECT_URL",
        "DOTENV_KEY",
        "DOTENV_PRIVATE_KEY",
        "EMBEDDING_MODEL",
        "GATHER_API_IO_LOG_DIR",
        "GATHER_API_IO_LOG_MAX_CHARS",
        "GATHER_HOST",
        "GATHER_OPENCLI_BIN",
        "GATHER_OPENCLI_CWD",
        "GATHER_PLAYWRIGHT_POOL_SWEEP_INTERVAL_MS",
        "GATHER_PORT",
        "GATHER_RELOAD",
        "GATHER_SERVICE_URL",
        "GOOGLE_GENERATIVE_AI_API_KEY",
        "LLM_DEFAULT_MODEL",
        "LOG_APP_NAME",
        "LOG_LEVEL",
        "MINIO_ACCESS_KEY",
        "MINIO_BUCKET",
        "MINIO_ENDPOINT",
        "MINIO_REGION",
        "MINIO_SECRET_KEY",
        "OPENAI_API_KEY",
        "OPEN_API_BASE_URL",
        "PARALLEL_API_ENDPOINT",
        "PARALLEL_API_KEY",
        "PRISMA_ACCELERATE_URL",
        "QUERY_SCHEDULE_TZ",
        "REDIS_HOST",
        "REDIS_PASSWORD",
        "REDIS_PORT",
        "S3_ACCESS_KEY",
        "S3_BUCKET",
        "S3_ENDPOINT",
        "S3_REGION",
        "S3_SECRET_KEY",
        "SEARCH_ENGINE",
        "TAVILY_API_ENDPOINT",
        "TAVILY_API_KEY",
        "WEB_DERIVE_IO_LOG_DIR",
        "WEB_DERIVE_IO_LOG_ENABLED",
        "WEB_DERIVE_IO_LOG_MAX_CHARS",
        "WEB_DERIVE_RECALL_SOFT_LIMIT",
        "WORKER_API_IO_LOG_DIR",
        "WORKER_API_IO_LOG_ENABLED",
        "WORKER_API_IO_LOG_MAX_CHARS",
        "WORKER_CAPABILITIES_HOST",
        "WORKER_CAPABILITIES_HTTP_ENABLED",
        "WORKER_CAPABILITIES_PORT",
        "WORKER_PARALLEL_REQUEST_TIMEOUT_MS",
        "WORKER_SERVICE_URL"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
