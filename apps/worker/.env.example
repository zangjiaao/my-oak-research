# Shared env
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/oak_research
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/oak_research

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

MINIO_ENDPOINT=http://localhost:9000
MINIO_REGION=us-east-1
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=oak-research

GATHER_SERVICE_URL=http://localhost:8000
WORKER_SERVICE_URL=http://localhost:8100
# openssl rand -base64 32
CREDENTIAL_ENCRYPTION_KEY=REPLACE_WITH_BASE64_32BYTE_KEY

# bb-site preset sync
BB_SITE_ROOT=/Users/yourname/Reference/bb-sites
BB_PRESET_SNAPSHOT_ENABLED=true

OPENAI_API_KEY=YOUR_OPENAI_API_KEY
OPEN_API_BASE_URL=https://api.openai.com/v1
DEEPSEEK_API_KEY=YOUR_DEEPSEEK_API_KEY
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
GOOGLE_GENERATIVE_AI_API_KEY=YOUR_GEMINI_API_KEY

# Search providers
SEARCH_ENGINE=auto
# keyword derive calibration engine: auto | anspire | tavily | parallel
PARALLEL_API_KEY=YOUR_PARALLEL_API_KEY
TAVILY_API_KEY=YOUR_TAVILY_API_KEY
ANSPIRE_API_KEY=YOUR_ANSPIRE_API_KEY
PARALLEL_API_ENDPOINT=https://api.parallel.ai/v1beta/search
TAVILY_API_ENDPOINT=https://api.tavily.com/search
ANSPIRE_API_ENDPOINT=https://plugin.anspire.cn/api/ntsearch/prosearch

LLM_DEFAULT_MODEL=gpt-4o
EMBEDDING_MODEL=text-embedding-3-small

LOG_LEVEL=info

# Worker env
LOG_APP_NAME=worker
WORKER_CAPABILITIES_HTTP_ENABLED=true
WORKER_CAPABILITIES_HOST=0.0.0.0
WORKER_CAPABILITIES_PORT=8100
COLLECT_SOURCE_CONCURRENCY=3
COLLECT_RECALL_QUERY_LIMIT=64
WORKER_PARALLEL_REQUEST_TIMEOUT_MS=90000
COLLECTOR_SKIP_AI_SUMMARY=false
COLLECTOR_ENABLE_SUBJECT_AI_SCORE=false
WORKER_API_IO_LOG_ENABLED=false
WORKER_API_IO_LOG_DIR=apps/worker/logs
WORKER_API_IO_LOG_MAX_CHARS=12000
