# Core infrastructure
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/oak_research
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/oak_research

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

MINIO_ENDPOINT=http://localhost:9000
MINIO_REGION=us-east-1
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=oak-research

# Internal service endpoints
GATHER_SERVICE_URL=http://localhost:8000
WORKER_SERVICE_URL=http://localhost:8100

# Credential crypto
# openssl rand -base64 32
CREDENTIAL_ENCRYPTION_KEY=REPLACE_WITH_BASE64_32BYTE_KEY

# LLM providers (used by @oak/agents in worker pipeline)
OPENAI_API_KEY=YOUR_OPENAI_API_KEY
OPEN_API_BASE_URL=https://api.openai.com/v1
DEEPSEEK_API_KEY=YOUR_DEEPSEEK_API_KEY
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
GOOGLE_GENERATIVE_AI_API_KEY=YOUR_GEMINI_API_KEY
LLM_DEFAULT_MODEL=gpt-4o
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_PROVIDER=openai
EMBEDDING_DIM=1536
LOCAL_EMBED_MODEL=hf:Qwen/Qwen3-Embedding-0.6B-GGUF/Qwen3-Embedding-0.6B-Q8_0.gguf
LOCAL_EMBED_CACHE_DIR=~/.cache/oak/models
LOCAL_EMBED_THREADS=4
LOCAL_EMBED_BATCH_SIZE=16

# Worker runtime
LOG_LEVEL=info
LOG_APP_NAME=worker

WORKER_CAPABILITIES_HTTP_ENABLED=true
WORKER_CAPABILITIES_HOST=0.0.0.0
WORKER_CAPABILITIES_PORT=8100

COLLECT_SOURCE_CONCURRENCY=3
COLLECT_RECALL_QUERY_LIMIT=64
TOPIC_RECALL_LLM_ENABLED=true
TOPIC_RECALL_QUERY_LIMIT=8
TOPIC_RECALL_TIMEOUT_MS=8000
COLLECTOR_SKIP_AI_SUMMARY=false
COLLECTOR_ENABLE_SUBJECT_AI_SCORE=false
RETRIEVAL_VECTOR_TOP_N=15
RETRIEVAL_BM25_TOP_N=30
RETRIEVAL_FUSION_ALPHA=0.65
RETRIEVAL_HIGH_THRESHOLD=0.7
RETRIEVAL_LOW_THRESHOLD=0.5
WORKER_PARALLEL_REQUEST_TIMEOUT_MS=90000

WORKER_API_IO_LOG_ENABLED=false
WORKER_API_IO_LOG_DIR=apps/worker/logs
WORKER_API_IO_LOG_MAX_CHARS=12000
