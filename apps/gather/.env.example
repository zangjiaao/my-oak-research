# Gather runtime
GATHER_HOST=0.0.0.0
GATHER_PORT=8000
GATHER_RELOAD=true

# Gather API I/O log
GATHER_API_IO_LOG_ENABLED=false
GATHER_API_IO_LOG_DIR=apps/gather/logs
GATHER_API_IO_LOG_MAX_CHARS=120000

# Optional OpenCLI / Playwright tuning
GATHER_PLAYWRIGHT_POOL_SWEEP_INTERVAL_MS=5000

# Optional local auth shortcuts
# X_COOKIE=your_cookie_here
# TELEGRAM_API_ID=your_api_id
# TELEGRAM_API_HASH=your_api_hash
# TELEGRAM_PHONE=your_phone
