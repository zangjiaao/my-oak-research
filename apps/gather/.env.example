# Shared env
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/oak_research
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/oak_research

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

MINIO_ENDPOINT=http://localhost:9000
MINIO_REGION=us-east-1
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=oak-research

GATHER_SERVICE_URL=http://localhost:8000
WORKER_SERVICE_URL=http://localhost:8100
# openssl rand -base64 32
CREDENTIAL_ENCRYPTION_KEY=REPLACE_WITH_BASE64_32BYTE_KEY

# bb-site preset sync
BB_SITE_ROOT=/Users/yourname/Reference/bb-sites
BB_PRESET_SNAPSHOT_ENABLED=true

OPENAI_API_KEY=YOUR_OPENAI_API_KEY
OPEN_API_BASE_URL=https://api.openai.com/v1
DEEPSEEK_API_KEY=YOUR_DEEPSEEK_API_KEY
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
GOOGLE_GENERATIVE_AI_API_KEY=YOUR_GEMINI_API_KEY

# Search providers
SEARCH_ENGINE=auto
# keyword derive calibration engine: auto | anspire | tavily | parallel
PARALLEL_API_KEY=YOUR_PARALLEL_API_KEY
TAVILY_API_KEY=YOUR_TAVILY_API_KEY
ANSPIRE_API_KEY=YOUR_ANSPIRE_API_KEY
PARALLEL_API_ENDPOINT=https://api.parallel.ai/v1beta/search
TAVILY_API_ENDPOINT=https://api.tavily.com/search
ANSPIRE_API_ENDPOINT=https://plugin.anspire.cn/api/ntsearch/prosearch

LLM_DEFAULT_MODEL=gpt-4o
EMBEDDING_MODEL=text-embedding-3-small

LOG_LEVEL=info

# Gather env
GATHER_HOST=0.0.0.0
GATHER_PORT=8000
GATHER_RELOAD=true
GATHER_API_IO_LOG_ENABLED=false
GATHER_API_IO_LOG_DIR=apps/gather/logs
GATHER_API_IO_LOG_MAX_CHARS=120000
# Optional: force gather to use a specific agent-browser binary path.
# AGENT_BROWSER_BIN=/opt/homebrew/bin/agent-browser

# X_COOKIE=your_cookie_here
# TELEGRAM_API_ID=your_api_id
# TELEGRAM_API_HASH=your_api_hash
# TELEGRAM_PHONE=your_phone
