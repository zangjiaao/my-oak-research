// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider        = "prisma-client-js"
  output          = "../app/generated/prisma"
  previewFeatures = []
}

datasource db {
  provider = "postgresql"
}

model Category {
  id          String    @id @default(cuid())
  name        String
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  keywords    Keyword[]

  @@unique([name])
}

model Keyword {
  id          String  @id @default(cuid())
  name        String
  description String?
  lang        String?

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id])

  includes       String[]
  excludes       String[]
  deriveLanguages String[] @default([])
  enableAiExpand Boolean  @default(false)
  synonyms       String[]
  active         Boolean  @default(true)
  deriveSourceId String?
  deriveSource   Source?  @relation("KeywordDeriveSource", fields: [deriveSourceId], references: [id])

  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  queries         Query[]
  contentKeywords ContentKeyword[]
  contentSubjectMatches ContentSubjectMatch[]

  @@unique([name])
}

enum SourceCategory {
  STREAM
  INTERACTIVE
  RETRIEVAL
}

enum CrawlerEngine {
  FETCH // node-fetch/undici
  CHEERIO // 轻量解析
  PLAYWRIGHT // 有头/无头浏览器渲染
  PUPPETEER
  CUSTOM
}

enum ProxyType {
  HTTP
  HTTPS
  SOCKS4
  SOCKS5
  TOR // 语义上的 Tor（底层通常也是 SOCKS5）
}

enum SearchEngineKind {
  GOOGLE
  BING
  DDG
  SEARXNG
  CUSTOM
}

enum SearchPlatform {
  PARALLEL
  TAVILY
  ANSPIRE
  CUSTOM
}

enum KeywordStrategy {
  AUTO
  RECALL_ONLY
  PRECISION_ONLY
  HYBRID
}

enum ContentSubjectMatchSource {
  QUERY
  GATHER
  AI
  FUSED
}

model Proxy {
  id        String    @id @default(cuid())
  name      String
  type      ProxyType
  // 建议统一 URL 形态保存，包含认证：scheme://user:pass@host:port
  url       String
  active    Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  // 反向引用
  sources          Source[]
  // 某些配置表也可能有 override：
  darknetOverrides DarknetSourceConfig[] // 可选
  webOverrides     WebSourceConfig[] // 可选
  socialOverrides  SocialMediaSourceConfig[] // 可选
}

model Credential {
  id        String   @id @default(cuid())
  name      String
  // 分类标签（便于审计/过滤）
  kind      String // e.g. "search-api", "x-oauth", "telegram-bot"
  // 建议密文或 KMS/vault 引用；此处示例用 Json 承载（生产可改成外部密管）
  data      Json // { apiKey: "...", bearerToken: "...", ... }
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // 反向引用
  sources Source[]

  socialOverrides SocialMediaSourceConfig[] // 可选
  searchOverrides SearchEngineSourceConfig[] // 可选
}

model Source {
  id            String     @id @default(cuid())
  name          String
  description   String?
  category      SourceCategory
  isDarknet     Boolean    @default(false)
  active        Boolean    @default(true)
  rateLimit     Int? // req/min
  lastFetchedAt DateTime?
  lastStatus    String?

  // 通用：若来源级别就配了代理/凭据（各 config 可局部覆盖）
  proxyId String?
  proxy   Proxy?  @relation(fields: [proxyId], references: [id])

  credentialId String?
  credential   Credential? @relation(fields: [credentialId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // 1:1 configs（按类型存在其一）
  web     WebSourceConfig?
  darknet DarknetSourceConfig?
  search  SearchEngineSourceConfig?
  social  SocialMediaSourceConfig?
  identity SourceIdentity?
  queries Query[]
  derivedKeywords Keyword[] @relation("KeywordDeriveSource")
  querySourcePolicies QuerySourcePolicy[]
  topicSources TopicSource[]
  jobSources JobSource[]

  @@unique([name])
  @@index([category])
  @@index([isDarknet])
}

model SourceIdentity {
  id             String   @id @default(cuid())
  sourceId       String   @unique
  source         Source   @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  category       SourceCategory
  isDarknet      Boolean        @default(false)
  platform       String
  driver         String
  intentType     String
  intentArgsHash String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([category, isDarknet, platform, driver, intentType, intentArgsHash])
  @@index([category, isDarknet, platform, driver, intentType])
}

model WebSourceConfig {
  sourceId String @id
  source   Source @relation(fields: [sourceId], references: [id])

  url           String[] // 必填
  headers       Json? // { "User-Agent": "...", ... }
  crawlerEngine CrawlerEngine @default(FETCH)
  // 抓取/解析策略：是否渲染、分页规则、选择器等
  render        Boolean       @default(false)
  parseRules    Json? // { listSelector: "...", title: "...", content: "...", nextSelector: "...", ... }
  robotsRespect Boolean       @default(true)

  // 可覆盖 Source 上的代理
  proxyId String?
  proxy   Proxy?  @relation(fields: [proxyId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model DarknetSourceConfig {
  sourceId String @id
  source   Source @relation(fields: [sourceId], references: [id])

  url           String[] // .onion 等
  headers       Json?
  crawlerEngine CrawlerEngine @default(FETCH)

  // Darknet 通常强制使用代理（TOR/SOCKS5）
  proxyId String // REQUIRED
  proxy   Proxy  @relation(fields: [proxyId], references: [id])

  render     Boolean  @default(false)
  parseRules Json?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model SearchEngineSourceConfig {
  sourceId String @id
  source   Source @relation(fields: [sourceId], references: [id])

  platform    SearchPlatform @default(CUSTOM)
  engine      SearchEngineKind
  // 标准字段
  objective   String
  // API 调用端点（某些场景用自建 SearXNG 或第三方 API）
  apiEndpoint String?
  // 透传额外参数（时间窗、结果数、safe mode 等）
  options     Json? // { timeRange: "7d", num: 50, safe: "active", ... }
  keywordStrategy KeywordStrategy @default(AUTO)

  // 覆盖凭据（优先级：config > source）
  credentialId String?
  credential   Credential? @relation(fields: [credentialId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SocialMediaSourceConfig {
  sourceId String @id
  source   Source @relation(fields: [sourceId], references: [id])

  platform String

  // 为减少多列空值，这里用 Json 承载平台特定字段：
  // X: { user?: "...", listId?: "...", query?: "..." }
  // Telegram: { channel: "@xxx" | "12345", mode?: "history|updates" }
  // Reddit: { subreddit: "xxx", sort?: "hot|new|top" }
  config Json

  // API / token 等（优先级：config > source）
  credentialId String?
  credential   Credential? @relation(fields: [credentialId], references: [id])

  // 某些平台也允许代理覆盖（比如地区限制）
  proxyId String?
  proxy   Proxy?  @relation(fields: [proxyId], references: [id])
  keywordStrategy KeywordStrategy @default(AUTO)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum QueryFrequency {
  MANUAL
  HOURLY
  DAILY
  WEEKLY
  MONTHLY
  CRONTAB // New type for custom cron schedules
}

enum TopicTermType {
  CORE
  EXPANSION
  EXCLUSION
}

enum JobType {
  TOPIC_RETRIEVAL
  SOURCE_INGEST
  SOURCE_ONESHOT
}

enum QueryContentFilterMode {
  TERM_AND_WORD_BOUNDARY
  CONTAINS
  SMART
}

model Query {
  id          String  @id @default(cuid())
  name        String  @unique
  description String?

  enabled      Boolean        @default(true)
  rateLimit    Int?
  frequency    QueryFrequency @default(MANUAL)
  cronSchedule String? // Field to store crontab string

  keywords Keyword[]
  sources  Source[]
  sourcePolicies QuerySourcePolicy[]

  rules Json?

  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  queryRuns QueryRun[]
}

model QuerySourcePolicy {
  id                   String                 @id @default(cuid())
  queryId              String
  sourceId             String
  contentFilterEnabled Boolean                @default(true)
  contentFilterMode    QueryContentFilterMode @default(TERM_AND_WORD_BOUNDARY)
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
  query                Query                  @relation(fields: [queryId], references: [id], onDelete: Cascade)
  source               Source                 @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@unique([queryId, sourceId])
  @@index([sourceId])
}

model Topic {
  id           String      @id @default(cuid())
  name         String      @unique
  description  String?
  enabled      Boolean     @default(true)
  frequency    QueryFrequency @default(MANUAL)
  cronSchedule String?
  vector       Unsupported("vector(1536)")?
  profile      Json?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  terms        TopicTerm[]
  sources      TopicSource[]
  jobTopics    JobTopic[]
  scores       ContentTopicScore[]
}

model TopicTerm {
  id        String       @id @default(cuid())
  topicId   String
  topic     Topic        @relation(fields: [topicId], references: [id], onDelete: Cascade)
  type      TopicTermType
  value     String
  weight    Float        @default(1)
  meta      Json?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@unique([topicId, type, value])
  @@index([topicId, type])
}

model TopicSource {
  id          String   @id @default(cuid())
  topicId      String
  sourceId     String
  enabled      Boolean @default(true)
  retrievalPolicy Json?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  topic         Topic  @relation(fields: [topicId], references: [id], onDelete: Cascade)
  source        Source @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@unique([topicId, sourceId])
  @@index([sourceId])
}

model Job {
  id            String         @id @default(cuid())
  name          String         @unique
  type          JobType
  enabled       Boolean        @default(true)
  frequency     QueryFrequency @default(MANUAL)
  cronSchedule  String?
  triggerMode   String?        // manual | scheduled | event
  config        Json?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  jobTopics     JobTopic[]
  jobSources    JobSource[]
  runs          JobRun[]
}

model JobTopic {
  id        String   @id @default(cuid())
  jobId      String
  topicId    String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  job        Job     @relation(fields: [jobId], references: [id], onDelete: Cascade)
  topic      Topic   @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@unique([jobId, topicId])
  @@index([topicId])
}

model JobSource {
  id              String   @id @default(cuid())
  jobId            String
  sourceId         String
  recallBindingOverride Json?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  job              Job     @relation(fields: [jobId], references: [id], onDelete: Cascade)
  source           Source  @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@unique([jobId, sourceId])
  @@index([sourceId])
}

model JobRun {
  id         String      @id @default(cuid())
  jobId      String
  status     TaskStatus  @default(PENDING)
  progress   Int         @default(0)
  trigger    String?
  startedAt  DateTime?
  finishedAt DateTime?
  error      String?
  meta       Json?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  job        Job         @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId, createdAt])
}

// ------------------------------
// Task/Run tracking for queries
// ------------------------------

enum TaskStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
  CANCELLED
}

model QueryRun {
  id         String      @id @default(cuid())
  queryId    String
  query      Query       @relation(fields: [queryId], references: [id], onDelete: Cascade)
  status     TaskStatus  @default(PENDING)
  progress   Int         @default(0) // 0-100
  error      String?
  startedAt  DateTime?
  finishedAt DateTime?
  meta       Json?
  events     TaskEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([queryId, createdAt])
}

model TaskEvent {
  id        String   @id @default(cuid())
  runId     String
  run       QueryRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  type      String // e.g. enqueue | start | fetch | clean | summary | store | progress | done | error
  message   String
  data      Json?
  createdAt DateTime @default(now())

  @@index([runId, createdAt])
}

enum ContentType {
  Web
  Client
  Darknet
}

model Content {
  id        String           @id @default(cuid())
  title     String
  summary   String
  markdown  String
  platform  String
  type      ContentType
  time      DateTime
  url       String?
  image     String? // 封面图（可选）
  meta      Json?
  keywords  ContentKeyword[]
  subjectMatches ContentSubjectMatch[]
  topicScores ContentTopicScore[]
  entities  ContentEntity?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  favorites Favorite[]

  @@index([platform, time])
  @@index([type, time])
}

model ContentKeyword {
  id        String  @id @default(cuid())
  contentId String
  keywordId String
  content   Content @relation(fields: [contentId], references: [id], onDelete: Cascade)
  keyword   Keyword @relation(fields: [keywordId], references: [id], onDelete: Cascade)

  @@unique([contentId, keywordId])
}

model ContentSubjectMatch {
  id              String                    @id @default(cuid())
  contentId       String
  keywordId       String
  ruleScore       Float?
  aiScore         Float?
  matchScore      Float?
  matchedIncludes String[]
  matchedExcludes String[]
  matchSource     ContentSubjectMatchSource @default(QUERY)
  reason          String?
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt
  content         Content                   @relation(fields: [contentId], references: [id], onDelete: Cascade)
  keyword         Keyword                   @relation(fields: [keywordId], references: [id], onDelete: Cascade)

  @@unique([contentId, keywordId])
  @@index([keywordId, matchScore])
  @@index([keywordId, createdAt])
  @@index([contentId])
  @@index([matchSource])
}

model ContentEntity {
  id        String   @id @default(cuid())
  contentId String   @unique
  persons   String[]
  orgs      String[]
  locations String[]
  content   Content  @relation(fields: [contentId], references: [id], onDelete: Cascade)
}

model ContentTopicScore {
  id           String   @id @default(cuid())
  contentId    String
  topicId      String
  vectorScore  Float?
  keywordScore Float?
  exclusionPenalty Float?
  finalScore   Float?
  reason       String?
  explain      Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  content      Content  @relation(fields: [contentId], references: [id], onDelete: Cascade)
  topic        Topic    @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@unique([contentId, topicId])
  @@index([topicId, finalScore])
  @@index([contentId])
}

model Favorite {
  id        String   @id @default(cuid())
  userId    String
  contentId String
  content   Content  @relation(fields: [contentId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, contentId])
}

enum MaterialSource {
  FAVORITE
  KNOWLEDGE
}

enum ReportStatus {
  DRAFT
  REVIEW
  PUBLISHED
}

model ReportTemplate {
  id          String   @id @default(cuid())
  name        String
  description String?
  markdown    String?
  metadata    Json?
  createdBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  reports     Report[]
}

model Report {
  id         String       @id @default(cuid())
  title      String
  summary    String?
  status     ReportStatus @default(DRAFT)
  templateId String?
  authorId   String?
  markdown   String?
  metadata   Json?
  version    Int          @default(1)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  template    ReportTemplate?  @relation(fields: [templateId], references: [id])
  materials   ReportMaterial[]
  chatSession ChatSession?
}

model ChatSession {
  id        String        @id @default(cuid())
  title     String?
  userId    String?
  metadata  Json?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  messages  ChatMessage[]
  reportId  String?       @unique
  report    Report?       @relation(fields: [reportId], references: [id], onDelete: SetNull)
}

model ChatMessage {
  id            String      @id @default(cuid())
  sessionId     String
  role          String // "user", "assistant", "system"
  content       String
  metadata      Json?
  createdAt     DateTime    @default(now())
  session       ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
}

model ReportMaterial {
  id         String         @id @default(cuid())
  reportId   String
  sourceType MaterialSource
  sourceId   String
  title      String?
  snippet    String?
  metadata   Json?
  createdAt  DateTime       @default(now())

  report Report @relation(fields: [reportId], references: [id], onDelete: Cascade)
}

model Knowledge {
  id              String           @id @default(cuid())
  name            String
  description     String?
  ownerId         String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  files           KnowledgeFile[]
  knowledgeChunks KnowledgeChunk[]
}

model KnowledgeFile {
  id          String   @id @default(cuid())
  knowledgeId String
  name        String
  mimeType    String?
  size        Int?
  storageKey  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  knowledge Knowledge        @relation(fields: [knowledgeId], references: [id], onDelete: Cascade)
  chunks    KnowledgeChunk[]
}

model KnowledgeChunk {
  id          String   @id @default(cuid())
  knowledgeId String
  fileId      String?
  content     String
  metadata    Json?
  embedding   Unsupported("vector(1536)")?
  chunkIndex  Int      @default(0)
  createdAt   DateTime @default(now())

  knowledge Knowledge      @relation(fields: [knowledgeId], references: [id], onDelete: Cascade)
  file      KnowledgeFile? @relation(fields: [fileId], references: [id])

  @@index([knowledgeId])
}
