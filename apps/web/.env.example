# Environment variables declared in this file are automatically made available to Prisma.
# See the documentation for more detail: https://pris.ly/d/prisma-schema#accessing-environment-variables-from-the-schema

# Prisma supports the native connection string format for PostgreSQL, MySQL, SQLite, SQL Server, MongoDB and CockroachDB.
# See the documentation for all the connection string options: https://pris.ly/d/connection-strings

# The following `prisma+postgres` URL is similar to the URL produced by running a local Prisma Postgres 
# server with the `prisma dev` CLI command, when not choosing any non-default ports or settings. The API key, unlike the 
# one found in a remote Prisma Postgres URL, does not contain any sensitive information.

# Prisma 配置
DIRECT_URL="postgresql://postgres.fiboyyhjvrnsbqqqqtir:[YOUR-PASSWORD]@aws-1-ap-southeast-1.pooler.supabase.com:5432/postgres"
DATABASE_URL="postgresql://postgres.fiboyyhjvrnsbqqqqtir:[YOUR-PASSWORD]@aws-1-ap-southeast-1.pooler.supabase.com:6543/postgres"
PRISMA_ACCELERATE_URL=""

# LLM Gateway 配置
OPENAI_API_KEY="YOUR_OPENAI_API_KEY"
OPEN_API_BASE_URL="https://api.openai.com/v1"

DEEPSEEK_API_KEY="YOUR_DEEPSEEK_API_KEY"
DEEPSEEK_BASE_URL="https://api.deepseek.com/v1"

GOOGLE_GENERATIVE_AI_API_KEY="YOUR_GEMINI_API_KEY"

LLM_DEFAULT_MODEL="gpt-4o"
EMBEDDING_MODEL="text-embedding-3-small"

# MinIO 配置
MINIO_ENDPOINT=http://localhost:9000
MINIO_REGION=us-east-1
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=oak-research

# -----------------------------------------------------------------------------
# Local Docker Defaults (docker/local/docker-compose.dev.yml)
# -----------------------------------------------------------------------------
# If you want to run everything against local Docker services, you can use:
# DIRECT_URL="postgresql://postgres:postgres@localhost:5432/oak_research"
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/oak_research"
# REDIS_HOST=127.0.0.1
# REDIS_PORT=6379
# REDIS_PASSWORD=

# Logging (optional)
LOG_APP_NAME=web
LOG_LEVEL=info
