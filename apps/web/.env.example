# Core infrastructure
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/oak_research
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/oak_research

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

MINIO_ENDPOINT=http://localhost:9000
MINIO_REGION=us-east-1
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=oak-research

# Optional S3-compatible overrides
S3_ENDPOINT=
S3_REGION=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=

# Internal service endpoints
GATHER_SERVICE_URL=http://localhost:8000
WORKER_SERVICE_URL=http://localhost:8100

# Credential crypto
# openssl rand -base64 32
CREDENTIAL_ENCRYPTION_KEY=REPLACE_WITH_BASE64_32BYTE_KEY

# LLM providers
OPENAI_API_KEY=YOUR_OPENAI_API_KEY
OPEN_API_BASE_URL=https://api.openai.com/v1
DEEPSEEK_API_KEY=YOUR_DEEPSEEK_API_KEY
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DASHSCOPE_API_KEY=YOUR_DASHSCOPE_API_KEY
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
GOOGLE_GENERATIVE_AI_API_KEY=YOUR_GEMINI_API_KEY
LLM_DEFAULT_MODEL=gpt-4o
EMBEDDING_MODEL=text-embedding-3-small
# openai | deepseek | dashscope | google | local_gguf
EMBEDDING_PROVIDER=openai
EMBEDDING_DIM=1536
# embedding request guards (DashScope: max lines=10, max input tokens=8192)
EMBEDDING_MAX_BATCH_LINES=8
EMBEDDING_MAX_INPUT_TOKENS=6000
EMBEDDING_MAX_INPUT_CHARS=8000
EMBEDDING_RETRY_LIMIT=2
LOCAL_EMBED_MODEL=hf:Qwen/Qwen3-Embedding-0.6B-GGUF/Qwen3-Embedding-0.6B-Q8_0.gguf
LOCAL_EMBED_CACHE_DIR=~/.cache/oak/models
LOCAL_EMBED_THREADS=4
LOCAL_EMBED_BATCH_SIZE=16

# Web runtime
DEFAULT_USER_ID=default-user-id
PRISMA_ACCELERATE_URL=
QUERY_SCHEDULE_TZ=UTC
# topic filtering default (0~1)
TOPIC_FILTER_MIN_SCORE=0.4
NEXT_PUBLIC_TOPIC_FILTER_MIN_SCORE=0.4
LOG_LEVEL=info
LOG_APP_NAME=web

# LLM rerank (used by web API routes, e.g. /api/focus-bulletin/content/:id/rerank)
RETRIEVAL_LLM_RERANK_ENABLED=false
RETRIEVAL_LLM_RERANK_TOP_N=8
# current code clamps this value to <= 0.5
RETRIEVAL_LLM_RERANK_WEIGHT=0.2
RETRIEVAL_LLM_RERANK_MIN_SCORE=0.55
